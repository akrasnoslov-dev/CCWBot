# Copy this file to .env and fill in secrets/IDs.
# Model names are explicit on purpose so they can be switched without a code deploy.

# Runtime
ENVIRONMENT=development

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_BOT_USERNAME=

# Market data
COINGECKO_API_KEY=

# LLM providers and model switches
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_EVENT_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_EVENT_RENDER_MODEL=openai/gpt-oss-20b
GROQ_MARKET_HEARTBEAT_MODEL=openai/gpt-oss-20b
GROQ_REPORT_MODEL=openai/gpt-oss-20b
GROQ_NEWS_INTELLIGENCE_MODEL=openai/gpt-oss-20b
GROQ_JSON_MODE=true

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MONTHLY_BUDGET_USD=2.50
# Required only for a separately approved paid activation. Bind verified current pricing and
# input limit to exactly OPENAI_MODEL; leaving any value blank blocks OpenAI before HTTP.
OPENAI_PRICED_MODEL=
OPENAI_MAX_INPUT_TOKENS=
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EVENT_RENDER_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# General free-first fallback chain. Disabled OpenAI is omitted without a request or delay.
LLM_PROVIDER_PRIORITY=groq,openai,cloudflare
# Event Analysis: Groq 120B -> optional OpenAI -> Cloudflare.
# Cloudflare is skipped unless both CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID are set.
LLM_EVENT_PROVIDERS=groq,openai,cloudflare
# Other optional per-task provider overrides:
# Reports deliberately stop at their verified data-only fallback after optional OpenAI.
LLM_REPORT_PROVIDERS=groq,openai
# LLM_HEARTBEAT_PROVIDERS=groq,openai,cloudflare
# LLM_NEWS_INTELLIGENCE_PROVIDERS=groq,openai,cloudflare
# LLM_EVENT_RENDER_PROVIDERS=groq,openai,cloudflare
# Event Analysis total operation budget (15-120s):
# LLM_EVENT_ANALYSIS_OPERATION_BUDGET_SECONDS=90

# Alert/news runtime
AUTOMATIC_CHECK_INTERVAL_SECONDS=1800
PRICE_CACHE_TTL_SECONDS=300
HEALTH_PORT=8080
ERROR_LOG_FILE=/app/logs/ccwbot-warnings-errors.log
ALERT_COOLDOWN_MINUTES=30
EVENT_ALERT_SEMANTIC_COOLDOWN_SECONDS=14400
SEEN_NEWS_KEEP_LATEST=500
ENABLE_NEWS_INTELLIGENCE=true
NEWS_INTELLIGENCE_MAX_ITEMS_PER_RUN=5
NEWS_INTELLIGENCE_MAX_LLM_CALLS_PER_RUN=3
NEWS_INTELLIGENCE_MAX_LLM_CALLS_PER_HOUR=20
NEWS_LLM_TIMEOUT_SECONDS=20
PREMIUM_MONTHLY_STARS=199

# PostgreSQL
# Docker Compose exposes PostgreSQL to the host on 127.0.0.1:15433.
DATABASE_URL=postgresql+asyncpg://ccwbot:replace-with-postgres-password@localhost:15433/ccwbot
POSTGRES_PASSWORD=replace-with-postgres-password

# Ops-agent has its own .ops-agent.env / .ops-agent.env.example.
