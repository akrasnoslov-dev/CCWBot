# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Alert behavior
PRICE_MOVE_ALERT_PERCENT=0.01
AUTOMATIC_CHECK_INTERVAL_SECONDS=300
PRICE_CACHE_TTL_SECONDS=300
ALERT_COOLDOWN_MINUTES=2

# Weekly report scheduling (UTC)
ENABLE_WEEKLY_REPORT=false
WEEKLY_REPORT_DAY=sunday
WEEKLY_REPORT_HOUR=9

# Strong signal checks
ENABLE_STRONG_SIGNAL_ALERTS=false
STRONG_SIGNAL_CHECK_INTERVAL_SECONDS=1800
STRONG_SIGNAL_COOLDOWN_HOURS=6

# Optional PostgreSQL (for future multi-user/shared state)
DATABASE_URL=postgresql+psycopg://ccwbot:ccwbot_password@localhost:5432/ccwbot