# Runtime
ENVIRONMENT=development

# Telegram
# Use a dev bot token locally and a production bot token on the VPS.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-alert-chat-id
TELEGRAM_ADMIN_USER_ID=111111111
# Optional comma-separated additional admins. TELEGRAM_ADMIN_USER_ID still works.
TELEGRAM_ADMIN_USER_IDS=111111111,222222222

# Groq AI
GROQ_API_KEY=replace-with-groq-api-key
# Valid options include llama-3.3-70b-versatile, llama-3.1-8b-instant, and gemma2-9b-it.
# See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EVENT_ANALYSIS_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_EVENT_ANALYSIS_MAX_TOKENS=300
GROQ_MARKET_HEARTBEAT_MODEL=llama-3.1-8b-instant
GROQ_REPORT_MODEL=llama-3.1-8b-instant
GROQ_NEWS_INTELLIGENCE_MODEL=llama-3.1-8b-instant
# Set false to disable OpenAI-compatible JSON mode while keeping structured parsing/fallbacks.
GROQ_JSON_MODE=true
# Set true to retry once without JSON mode after Groq json_validate_failed errors.
GROQ_JSON_MODE_RETRY_PLAIN=false

# LLM provider fallback (redundancy)
# Groq stays primary; Cerebras, Gemini, and Mistral are optional fallbacks tried in order when
# the current provider is rate limited, times out, or returns a 5xx. A provider with no API key
# is silently excluded from the chain (logged once), so leaving these blank keeps Groq-only
# behaviour. All four use the OpenAI-compatible chat API (Gemini via its OpenAI endpoint).
LLM_PROVIDER_PRIORITY=groq,cerebras,gemini,mistral
# Optional per-task-type overrides; fall back to LLM_PROVIDER_PRIORITY when unset.
# LLM_EVENT_PROVIDERS=groq,cerebras
# LLM_REPORT_PROVIDERS=groq,gemini
# LLM_HEARTBEAT_PROVIDERS=cerebras,groq
# Fallback provider credentials/models (leave blank to keep the provider out of the chain).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Backoff (seconds) applied to a provider/model when a rate limit gives no usable retry hint.
# Falls back to the historical GROQ_RATE_LIMIT_FALLBACK_BACKOFF_SECONDS when unset.
# LLM_RATE_LIMIT_FALLBACK_BACKOFF_SECONDS=300

# Alert behavior
# Event Alert LLM analysis cadence per symbol. Market Heartbeat cadence is separate.
AUTOMATIC_CHECK_INTERVAL_SECONDS=1800
PRICE_CACHE_TTL_SECONDS=300
# HTTP health check port.
HEALTH_PORT=8080
# Persistent warning/error log file used when enabled by admin command.
ERROR_LOG_FILE=/app/logs/ccwbot-warnings-errors.log
# Minutes to wait between automatic BTC movement alerts.
ALERT_COOLDOWN_MINUTES=30
# Seconds to suppress repeated Event Alerts for the same user, coin, and canonical event key.
EVENT_ALERT_SEMANTIC_COOLDOWN_SECONDS=14400
# Number of seen news rows to keep after daily cleanup.
SEEN_NEWS_KEEP_LATEST=500
# Budget-aware structured RSS news cache. Uses persistent news_items rows before LLM calls.
ENABLE_NEWS_INTELLIGENCE=true
# Standalone news-driven Event Alerts are disabled by product policy; the runtime ignores
# this flag except to log a one-time startup warning when it is set. It can be left unset
# or removed from production .env entirely.
ENABLE_NEWS_DRIVEN_ALERTS=false
NEWS_INTELLIGENCE_MAX_ITEMS_PER_RUN=5
NEWS_INTELLIGENCE_MAX_LLM_CALLS_PER_RUN=3
NEWS_INTELLIGENCE_MAX_LLM_CALLS_PER_HOUR=20
NEWS_LLM_TIMEOUT_SECONDS=20

# Telegram Stars Premium subscription price.
PREMIUM_MONTHLY_STARS=199

# Reports are cached by scheduled jobs: daily every 4h, weekly every 24h.
# Legacy weekly direct-send and strong-signal env vars are no longer used.

# Optional PostgreSQL for host-run local development. Docker Compose overrides this inside the bot container.
DATABASE_URL=postgresql+asyncpg://ccwbot:replace-with-postgres-password@localhost:5433/ccwbot
POSTGRES_PASSWORD=replace-with-postgres-password

# Ops-agent uses a separate template: .ops-agent.env.example.
# Do not put production OPS_AGENT_* values in the bot .env file.
