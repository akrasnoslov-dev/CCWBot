# Copy this file to .ops-agent.env in the repository root.
# Local path:      <repo>/.ops-agent.env
# Production path: /opt/CCWBot/.ops-agent.env
# .ops-agent.env is gitignored and must stay separate from the bot .env.
# On production keep it root:root with mode 600.

OPS_AGENT_DATABASE_URL=postgresql+asyncpg://ccwbot_ops_reader:replace-with-readonly-password@postgres:5432/ccwbot
OPS_AGENT_HEALTH_URL=http://bot:8080/health
# If the bot runs on the host instead of the Compose bot service:
# OPS_AGENT_HEALTH_URL=http://host.docker.internal:8080/health
OPS_AGENT_EVENT_ALERT_SEMANTIC_COOLDOWN_SECONDS=14400

# If the bot .env overrides GROQ_EVENT_ANALYSIS_MODEL, set the same expected primary model here
# so model-drift diagnostics distinguish an intentional switch from an accidental drift.
# OPS_AGENT_EXPECTED_EVENT_ANALYSIS_MODEL=openai/gpt-oss-120b
