# Production ops-agent environment template.
# Placeholder values only. Do not put real production values in this file.
# On production, create /opt/CCWBot/.ops-agent.env manually as root:root with mode 600.

OPS_AGENT_DATABASE_URL=postgresql+asyncpg://ccwbot_ops_reader:replace-with-readonly-password@postgres:5432/ccwbot
OPS_AGENT_HEALTH_URL=http://bot:8080/health
OPS_AGENT_EVENT_ALERT_SEMANTIC_COOLDOWN_SECONDS=14400

# Optional. The model-drift detector compares the model recorded in llm_usage_logs against the
# model the bot ships as its default for that call type. Set this only when the deployment
# intentionally pins a different model, to declare that divergence as expected.
# OPS_AGENT_EXPECTED_EVENT_ANALYSIS_MODEL=openai/gpt-oss-120b
