reports/**/models/
reports/**/runtime/
reports/**/host_evidence.json
reports/**/resource_samples.jsonl
reports/**/workstation.json
reports/**/*.log
reports/**/*.zip
reports/**/.env*

# Graphify tracked state is not blanket-ignored. Only disposable local outputs are ignored.
graphify-out/cache/
graphify-out/logs/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
