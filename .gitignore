# All durable project research is tracked under repository-root reports/.
# Only generated temp data, local hardware evidence, models, and secrets are ignored.
reports/**/__pycache__/
reports/**/.pytest_cache/
reports/**/.ruff_cache/
reports/**/pytest-cache-files-*/
reports/**/ccw41_*tmp*/
reports/**/ccw41_private_pre_scrub*/
